@model LoginViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in - PMRS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root { --pmrs-accent: #0d9488; --pmrs-nav: #1e293b; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; min-height: 100vh; margin: 0; display: flex; }
        .login-left { flex: 1; display: flex; align-items: center; justify-content: center; padding: 2rem; background: #faf9f7; }
        .login-right { width: 42%; min-width: 320px; background: linear-gradient(165deg, #0d9488 0%, #0f766e 100%); display: flex; align-items: center; justify-content: center; padding: 2rem; }
        .login-form { width: 100%; max-width: 360px; }
        .login-form .form-control { border-radius: 8px; padding: 0.6rem 0.85rem; }
        .login-form .btn { border-radius: 8px; padding: 0.6rem; font-weight: 600; }
        .brand-block { text-align: center; color: #fff; }
        .brand-block i { font-size: 3rem; opacity: .95; }
        .brand-block h1 { font-size: 1.75rem; font-weight: 700; margin-top: 1rem; }
        .brand-block p { opacity: .9; font-size: 0.95rem; }
        @@media (max-width: 768px) { .login-right { width: 100%; min-height: 200px; } body { flex-direction: column; } }
    </style>
</head>
<body>
    <div class="login-left">
        <div class="login-form">
            <h2 class="fw-bold mb-1">Welcome back</h2>
            <p class="text-muted small mb-4">Sign in to PMRS</p>
            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-500"></label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-500"></label>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label small"></label></div>
                <button type="submit" class="btn btn-primary w-100" style="background:#0d9488;border-color:#0d9488">Sign in</button>
            </form>
            <p class="text-center small mt-3 text-muted">No account? <a asp-action="Register" class="text-decoration-none fw-500" style="color:#0d9488">Register</a></p>
            <div class="mt-3 p-3 rounded-3 small text-muted" style="background:#f1f5f9">Demo: admin@pmrs.com / Admin@123</div>
        </div>
    </div>
    <div class="login-right">
        <div class="brand-block">
            <i class="bi bi-clipboard2-pulse"></i>
            <h1>PMRS</h1>
            <p>Patient &amp; Medical Records</p>
        </div>
    </div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

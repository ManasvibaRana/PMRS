@model RegisterViewModel
@{ ViewData["Title"] = "Register"; }
<div class="pmrs-card p-4 shadow-sm" style="max-width:480px;margin:2rem auto">
    <h2 class="fw-bold mb-1">Create account</h2>
    <p class="text-muted small mb-4">Register for PMRS</p>
    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="row g-2 mb-2">
            <div class="col"><label asp-for="FirstName" class="form-label small fw-500"></label><input asp-for="FirstName" class="form-control form-control-sm rounded-2" /></div>
            <div class="col"><label asp-for="LastName" class="form-label small fw-500"></label><input asp-for="LastName" class="form-control form-control-sm rounded-2" /></div>
        </div>
        <div class="mb-2"><label asp-for="Email" class="form-label small fw-500"></label><input asp-for="Email" class="form-control form-control-sm rounded-2" /><span asp-validation-for="Email" class="text-danger small"></span></div>
        <div class="mb-2"><label asp-for="Password" class="form-label small fw-500"></label><input asp-for="Password" class="form-control form-control-sm rounded-2" /><span asp-validation-for="Password" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label small fw-500"></label><input asp-for="ConfirmPassword" class="form-control form-control-sm rounded-2" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
        <button type="submit" class="btn pmrs-btn-primary w-100">Register</button>
    </form>
    <p class="text-center small mt-3 text-muted"><a asp-action="Login" class="text-decoration-none fw-500" style="color:#0d9488">Back to sign in</a></p>
</div>

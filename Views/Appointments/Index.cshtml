@model PaginatedList<Appointment>
@{ ViewData["Title"] = "Appointments"; }
<h1 class="pmrs-page-title">Appointments</h1>
<div class="pmrs-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span></span>
        <a asp-action="Create" class="btn btn-sm pmrs-btn-primary rounded-2">+ New appointment</a>
    </div>
    <div class="table-responsive">
        <table class="table pmrs-table">
            <thead><tr><th>#</th><th>Patient</th><th>Doctor</th><th>Date</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var a in Model.Items)
            {
                <tr>
                    <td><code class="small">@a.AppointmentNumber</code></td>
                    <td>@a.Patient.FullName</td>
                    <td class="text-muted small">@a.Doctor.FullName</td>
                    <td class="small">@a.ScheduledAt.ToString("MMM dd, yyyy HH:mm")</td>
                    <td><span class="pmrs-badge bg-light text-dark">@a.Status</span></td>
                    <td>
                        <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary rounded-2">View</a>
                        @if (a.Status != AppointmentStatus.Cancelled && a.Status != AppointmentStatus.Completed)
                        {
                            <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary rounded-2">Edit</a>
                            <form asp-action="Cancel" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('Cancel this appointment?');">@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger rounded-2">Cancel</button></form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Items.Any()) { <tr><td colspan="6" class="text-center text-muted py-5">No appointments.</td></tr> }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1) { <nav class="mt-3"><ul class="pagination pagination-sm justify-content-center mb-0">@for (int i = 1; i <= Model.TotalPages; i++) { <li class="page-item @(i == Model.PageNumber ? "active" : "")"><a class="page-link rounded-2 mx-1" asp-action="Index" asp-route-pageNumber="@i">@i</a></li> }</ul></nav> }
</div>

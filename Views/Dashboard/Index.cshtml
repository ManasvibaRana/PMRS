@model DashboardStats
@using PMRS.Enums
@{ ViewData["Title"] = "Dashboard"; }
<h1 class="pmrs-page-title">Dashboard</h1>
<div class="d-flex flex-wrap gap-3 mb-4" style="gap: 1rem !important;">
    <div class="pmrs-card p-3 d-flex align-items-center gap-3" style="min-width: 160px;">
        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: #ccfbf1;">
            <i class="bi bi-people-fill" style="color: #0d9488; font-size: 1.25rem;"></i>
        </div>
        <div>
            <div class="fs-4 fw-bold">@Model.TotalPatients</div>
            <div class="text-muted small">Patients</div>
        </div>
    </div>
    <div class="pmrs-card p-3 d-flex align-items-center gap-3" style="min-width: 160px;">
        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: #e0f2fe;">
            <i class="bi bi-calendar2-check-fill text-primary" style="font-size: 1.25rem;"></i>
        </div>
        <div>
            <div class="fs-4 fw-bold">@Model.TodayAppointments</div>
            <div class="text-muted small">Today</div>
        </div>
    </div>
    <div class="pmrs-card p-3 d-flex align-items-center gap-3" style="min-width: 160px;">
        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: #fef3c7;">
            <i class="bi bi-clock-history text-warning" style="font-size: 1.25rem;"></i>
        </div>
        <div>
            <div class="fs-4 fw-bold">@Model.PendingAppointments</div>
            <div class="text-muted small">Pending</div>
        </div>
    </div>
    <div class="pmrs-card p-3 d-flex align-items-center gap-3" style="min-width: 160px;">
        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: #f3e8ff;">
            <i class="bi bi-capsule-pill" style="color: #7c3aed; font-size: 1.25rem;"></i>
        </div>
        <div>
            <div class="fs-4 fw-bold">@Model.ActivePrescriptions</div>
            <div class="text-muted small">Active Rx</div>
        </div>
    </div>
</div>
<div class="row g-4">
    <div class="col-lg-7">
        <div class="pmrs-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-600 mb-0">Recent appointments</h6>
                <a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-2">View all</a>
            </div>
            @if (!Model.RecentAppointments.Any())
            {
                <p class="text-muted text-center py-4 mb-0"><i class="bi bi-calendar-x d-block fs-2 mb-2"></i>No appointments yet</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table pmrs-table mb-0">
                        <thead><tr><th>Patient</th><th>Doctor</th><th>Date</th><th>Status</th></tr></thead>
                        <tbody>
                        @foreach (var a in Model.RecentAppointments)
                        {
                            <tr>
                                <td>@a.PatientName</td>
                                <td class="text-muted small">@a.DoctorName</td>
                                <td class="small">@a.ScheduledAt.ToString("MMM dd, HH:mm")</td>
                                <td><span class="pmrs-badge bg-light text-dark">@a.Status</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="pmrs-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-600 mb-0">Recent patients</h6>
                <a asp-controller="Patients" asp-action="Create" class="btn btn-sm pmrs-btn-primary rounded-2">+ New</a>
            </div>
            @if (!Model.RecentPatients.Any())
            {
                <p class="text-muted text-center py-4 mb-0"><i class="bi bi-person-plus d-block fs-2 mb-2"></i>No patients yet</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                @foreach (var p in Model.RecentPatients)
                {
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center border-0 border-bottom">
                        <div>
                            <span class="fw-600 small">@p.FullName</span>
                            <div class="text-muted" style="font-size: 0.75rem;">@p.PatientNumber</div>
                        </div>
                        <span class="text-muted small">@p.RegisteredAt.ToString("MMM dd")</span>
                    </li>
                }
                </ul>
            }
        </div>
    </div>
</div>
<div class="row g-4 mt-0">
    <div class="col-12">
        <div class="pmrs-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-600 mb-0">Recent prescriptions</h6>
                <div class="d-flex gap-2">
                    <a asp-controller="Prescriptions" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-2">View all</a>
                    <a asp-controller="Prescriptions" asp-action="Create" class="btn btn-sm pmrs-btn-primary rounded-2">+ New prescription</a>
                </div>
            </div>
            @if (!Model.RecentPrescriptions.Any())
            {
                <p class="text-muted text-center py-4 mb-0"><i class="bi bi-capsule d-block fs-2 mb-2"></i>No prescriptions yet</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table pmrs-table mb-0">
                        <thead><tr><th>#</th><th>Patient</th><th>Doctor</th><th>Issued</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var p in Model.RecentPrescriptions)
                        {
                            <tr>
                                <td><code class="small">@p.PrescriptionNumber</code></td>
                                <td>@p.PatientName</td>
                                <td class="text-muted small">@p.DoctorName</td>
                                <td class="small">@p.IssuedAt.ToString("MMM dd, yyyy")</td>
                                <td><span class="pmrs-badge @(p.Status == PrescriptionStatus.Active ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary")">@p.Status</span></td>
                                <td><a asp-controller="Prescriptions" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary rounded-2">View</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

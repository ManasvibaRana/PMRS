@model PatientFormViewModel
@{ ViewData["Title"] = "Edit patient"; }
<h1 class="pmrs-page-title">Edit patient</h1>
<div class="pmrs-card p-4">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <partial name="_PatientForm" model="Model" />
        <div class="mt-3">
            <button type="submit" class="btn pmrs-btn-primary rounded-2">Update</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-2">Cancel</a>
        </div>
    </form>
</div>

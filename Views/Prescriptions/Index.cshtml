@model PaginatedList<Prescription>
@{ ViewData["Title"] = "Prescriptions"; }
<h1 class="pmrs-page-title">Prescriptions</h1>
<div class="pmrs-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span></span>
        <a asp-action="Create" class="btn btn-sm pmrs-btn-primary rounded-2">+ New prescription</a>
    </div>
    <div class="table-responsive">
        <table class="table pmrs-table">
            <thead><tr><th>#</th><th>Patient</th><th>Doctor</th><th>Issued</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var p in Model.Items) { <tr><td><code class="small">@p.PrescriptionNumber</code></td><td>@p.Patient.FullName</td><td class="text-muted small">@p.Doctor.FullName</td><td class="small">@p.IssuedAt.ToString("MMM dd, yyyy")</td><td><span class="pmrs-badge @(p.Status == PrescriptionStatus.Active ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary")">@p.Status</span></td><td><a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary rounded-2">View</a></td></tr> }
            @if (!Model.Items.Any()) { <tr><td colspan="6" class="text-center text-muted py-5">No prescriptions.</td></tr> }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1) { <nav class="mt-3"><ul class="pagination pagination-sm justify-content-center mb-0">@for (int i = 1; i <= Model.TotalPages; i++) { <li class="page-item @(i == Model.PageNumber ? "active" : "")"><a class="page-link rounded-2 mx-1" asp-action="Index" asp-route-pageNumber="@i">@i</a></li> }</ul></nav> }
</div>
